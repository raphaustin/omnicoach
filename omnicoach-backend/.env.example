# ─── Workout library ────────────────────────────────────────────────────────
# Path to the `converted/` folder of the canonical running library.
# Not bundled: the data is licensed personal-use only by its provider.
LIBRARY_PATH=./data/converted

# ─── LLM provider ───────────────────────────────────────────────────────────
# Pick ONE block. Switching provider is an .env change, never a code change.

# (A) FREE + LOCAL + UNLIMITED — the recommended default for development.
#     Install ollama.com, then: ollama pull qwen2.5:3b && ollama serve
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://localhost:11434

# (B) FREE + HOSTED — Google AI Studio. No credit card, Flash-class models.
#     ~1,500 requests/day, 15 req/min. Get a key at ai.google.dev.
#     NOTE: free-tier prompts may be used by Google to improve their products.
#     Fine for fake test athletes, not for real athlete data.
# LLM_PROVIDER=openai_compat
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-key-here

# (C) PAID — same class, different URL. Decide once the prototype works.
# LLM_PROVIDER=openai_compat
# LLM_MODEL=mistral-large-latest
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=your-key-here

# (D) NO LLM AT ALL — deterministic, for tests, CI and front-end work.
# LLM_PROVIDER=mock

LLM_TEMPERATURE=0
LLM_TIMEOUT_S=600
